# Capsule Configuration File
# Copy this to ~/.capsule/config.toml and fill in your Supabase credentials
# Get credentials from: https://supabase.com/dashboard → Project Settings → API
#
# For local development with docker-compose, use these throwaway keys:
# url = "http://supabase-kong:8000"
# service_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"
# anon_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
#
# Alternatively, set environment variables:
# export SUPABASE_URL="http://supabase-kong:8000"
# export SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# export SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

[supabase]
url = "https://your-project.supabase.co"
service_key = "your-service-role-key-here"
anon_key = "your-anon-key-here"
enabled = true

[transfer]
auto_transfer = false  # Set to true to auto-transfer after each session
batch_size = 100       # Number of syscalls to insert at once
